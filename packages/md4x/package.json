{
  "name": "md4x",
  "version": "0.0.29",
  "repository": "unjs/md4x",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./wasm": {
      "types": "./lib/wasm/index.d.mts",
      "unwasm": "./lib/wasm/unwasm.mjs",
      "browser": "./lib/standalone.mjs",
      "default": "./lib/wasm/default.mjs"
    },
    "./standalone": {
      "types": "./lib/standalone.d.mts",
      "default": "./lib/standalone.mjs"
    },
    "./napi": "./lib/napi.mjs",
    "./build/md4x.wasm": "./build/md4x.wasm",
    ".": {
      "types": "./lib/types.d.mts",
      "node": "./lib/napi.mjs",
      "unwasm": "./lib/wasm/unwasm.mjs",
      "browser": "./lib/standalone.mjs",
      "default": "./lib/wasm/default.mjs"
    }
  },
  "types": "./lib/types.d.mts",
  "bin": {
    "md4x": "./lib/cli.mjs"
  },
  "files": [
    "build",
    "!build/md4x-small.wasm",
    "!build/md4x-safe.wasm",
    "lib",
    "README.md"
  ],
  "scripts": {
    "prepack": "cd ../.. && zig build --verbose && zig build wasm && zig build wasm-small && bun scripts/build-standalone.ts"
  },
  "devDependencies": {
    "@ox-content/napi": "^2.89.0",
    "confbox": "^0.2.4",
    "js-yaml": "^5.2.3",
    "markdown-it": "^14.1.1",
    "markdown-it-mdc": "^0.2.12",
    "md4w": "^0.2.7",
    "md4x-c": "npm:md4x@latest",
    "mitata": "^1.0.34",
    "rangi": "^2.2.0",
    "satteri": "^0.9.5",
    "yaml": "^2.9.0"
  }
}
